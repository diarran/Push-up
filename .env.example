# Copier ce fichier en .env et renseigner les valeurs.

# Depuis le tableau de bord Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Mot de passe partage par le groupe pour entrer dans l'application.
# Verifie uniquement cote client : ne protege pas la base de donnees elle-meme
# (voir README, section "Pourquoi pas de comptes individuels").
VITE_GROUP_PASSCODE=change-moi
